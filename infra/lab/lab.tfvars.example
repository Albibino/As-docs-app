# Copie para terraform.tfvars e substitua pelo IPv4 público de saída do operador.
eks_api_access_cidrs = ["192.0.2.5/32"]

# Opcionais: trava de conta antes do primeiro apply e ajustes de catálogo.
# expected_account_id = "111122223333"
# eks_version         = "1.37"
# db_engine_version   = "18.6"
# db_instance_class   = "db.t3.micro"

# O padrão é learner_lab. Forneça a senha via TF_VAR_db_password, nunca aqui.
# Em conta comum que permite criar IAM, use iam_mode = "managed" sem essa senha.
# Se a descoberta não funcionar, informe os ARNs das roles da sua conta:
# eks_cluster_role_arn = "arn:aws:iam::111122223333:role/LabEksClusterRole"
# eks_node_role_arn    = "arn:aws:iam::111122223333:role/LabEksNodeRole"

# Desabilitar o CSI impede o provisionamento dos volumes gp3 da aplicação.
# eks_storage_enabled = false

# Deploy integral somente para um Learner Lab descartável com state novo:
# lab_full_deploy = true
# lab_ai_checkout = "../../../As-docs-ai" # padrão: repositório irmão
# Requer openai.auto.tfvars. Não combine com app_deploy/ai_oauth abaixo.

# Deploy por digests preexistentes, depois do bootstrap manual:
# keycloak_enabled  = true
# keycloak_lab_http = true # somente laboratório descartável, sem domínio/ACM
# app_deploy = {
#   backend_image  = "111122223333.dkr.ecr.us-east-1.amazonaws.com/as-docs-backend@sha256:<digest>"
#   frontend_image = "111122223333.dkr.ecr.us-east-1.amazonaws.com/as-docs-frontend@sha256:<digest>"
# }
# Para incluir IA, prepare os Secrets e use o mesmo digest de backend (docs/tcc/13-ia-oauth-aws.md):
# ai_oauth = {
#   backend_image = "<registro>/as-docs-backend@sha256:<digest>"
#   ai_image      = "<registro>/as-docs-ai@sha256:<digest>"
#   caddy_image   = "<registro>/caddy@sha256:<digest>"
#   provider_mode = "openai" # ou diagnostic para um laboratório descartável
# }
