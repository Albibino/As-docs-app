# Front-end (EC2 na subnet pública). Altere e reinicie o container; sem rebuild.
# Substitua pelo digest da imagem publicada para esta revisão.
FRONTEND_IMAGE=
# Endereço do backend na rede privada (NLB interno do EKS). Sem barra no final.
BACKEND_URL=http://internal-as-docs-backend-xxxx.elb.us-east-1.amazonaws.com:3000
# URL pública (domínio do ALB/Route 53). Deve ser igual ao APP_URL do backend.
PUBLIC_APP_URL=https://docs.exemplo.com
# Vazio = mesma origem (/collab via este Nginx).
COLLAB_URL=
FILE_UPLOAD_SIZE_LIMIT=50mb
FILE_IMPORT_SIZE_LIMIT=200mb
CLIENT_MAX_BODY_SIZE=200m
NGINX_PORT=8080
