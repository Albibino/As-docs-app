# Gerado no boot pelo entrypoint oficial do Nginx (envsubst).
# Variáveis: BACKEND_URL, PUBLIC_APP_URL, COLLAB_URL, FILE_*_SIZE_LIMIT,
# CLIENT_MAX_BODY_SIZE, DRAWIO_URL, NGINX_PORT, NGINX_LOCAL_RESOLVERS.

server_tokens off;

# Atrás do ALB o protocolo original vem em X-Forwarded-Proto; local, usa o do Nginx.
map $http_x_forwarded_proto $fwd_proto {
    default $fwd_proto;
    ''      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${NGINX_PORT};
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # DNS da VPC (lido do /etc/resolv.conf). Com proxy_pass em variável o Nginx
    # re-resolve o endereço do NLB interno quando os IPs dele mudam.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    set $backend ${BACKEND_URL};

    include /etc/nginx/snippets/security-headers.conf;

    # Health check do ALB (não depende do backend).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # O servidor MCP é consumido só pelo As-docs-ai dentro da rede privada.
    # Nunca expor na borda pública.
    location ^~ /mcp {
        return 404;
    }

    location ^~ /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 300s;
        proxy_buffering off;   # respostas em streaming da IA

        location ~ ^/api/auth/oidc/callback/?$ {
            # Herda os parâmetros de proxy de /api/. proxy_pass não é herdado.
            proxy_pass $backend;
            # Nem erros de upstream podem registrar code/state.
            access_log off;
            error_log /dev/null;
        }
    }

    location ^~ /socket.io/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 3600s;
    }

    location ^~ /collab {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 3600s;
    }

    # Assets com hash no nome: cache longo.
    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: qualquer rota cai no index.html, com a configuração de runtime
    # injetada no placeholder (o mesmo que o backend fazia no StaticModule).
    location / {
        try_files $uri /index.html;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        sub_filter_once on;
        sub_filter_types text/html;
        sub_filter '<!--window-config-->' '<script>window.CONFIG={"ENV":"production","APP_URL":"${PUBLIC_APP_URL}","FILE_UPLOAD_SIZE_LIMIT":"${FILE_UPLOAD_SIZE_LIMIT}","FILE_IMPORT_SIZE_LIMIT":"${FILE_IMPORT_SIZE_LIMIT}","DRAWIO_URL":"${DRAWIO_URL}","COLLAB_URL":"${COLLAB_URL}"};</script>';
    }
}
