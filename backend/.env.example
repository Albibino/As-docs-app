# Backend (EKS na subnet privada). No Kubernetes estes valores vêm do
# ConfigMap/Secret em deploy/k8s; este arquivo serve para rodar fora do cluster.
APP_URL=https://docs.exemplo.com
PORT=3000
APP_SECRET=replace-with-at-least-32-random-bytes   # openssl rand -hex 32
JWT_TOKEN_EXPIRES_IN=30d

# --- Banco (RDS PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://USUARIO:SENHA@as-docs.xxxx.us-east-1.rds.amazonaws.com:5432/asdocs?sslmode=require

# --- Redis 8 (filas/cache do app; DB 1) --------------------------------------
REDIS_URL=redis://redis.as-docs.svc.cluster.local:6379/1

# --- Arquivos ------------------------------------------------------------------
# local = volume do pod (só 1 réplica). s3 = bucket (permite várias réplicas).
STORAGE_DRIVER=local
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

MAIL_DRIVER=log
DISABLE_TELEMETRY=true
DEBUG_MODE=false
LOG_HTTP=false
TCC_SKIP_SEED=false

# --- Integração com o As-docs-ai ---------------------------------------------
DOCS_AI_URL=http://as-docs-ai.as-docs.svc.cluster.local:8000
DOCS_AI_HMAC_SECRET=replace-with-at-least-32-random-bytes
DOCS_AI_MCP_ENABLED=true
DOCS_AI_MCP_CREDENTIAL_TTL_SECONDS=120
DOCS_AI_INDEX_INTERVAL_SECONDS=30
