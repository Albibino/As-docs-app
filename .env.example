# Usado só pelo docker-compose.yml local. Para a AWS veja
# frontend/.env.example (EC2) e deploy/k8s (EKS).
APP_URL=http://localhost:8080
APP_SECRET=replace-with-at-least-32-random-bytes          # openssl rand -hex 32
DOCS_AI_HMAC_SECRET=replace-with-at-least-32-random-bytes # igual no As-docs-ai
DB_PASSWORD=as-local-db
AS_DOCS_AI_PATH=../As-docs-ai
AI_EMBEDDING_PROVIDER=hashing
AI_CHAT_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
