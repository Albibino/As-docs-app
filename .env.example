# Usado só pelo docker-compose.yml local. Para a AWS veja
# frontend/.env.example (EC2) e deploy/k8s (EKS).
APP_URL=http://localhost:8080
APP_SECRET=replace-with-at-least-32-random-bytes          # openssl rand -hex 32
DOCS_AI_HMAC_SECRET=replace-with-at-least-32-random-bytes # igual no As-docs-ai
DB_PASSWORD=as-local-db
AS_DOCS_AI_PATH=../As-docs-ai
AI_EMBEDDING_PROVIDER=hashing
AI_CHAT_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Keycloak local (perfil oidc). Preencha antes da primeira subida do provedor.
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Só o backend recebe OIDC_*. Ative com OIDC_ENABLED=true após o provisionamento.
OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:9090/realms/as-docs
OIDC_BACKCHANNEL_URL=http://keycloak:8080
OIDC_CLIENT_ID=docs-app-web
OIDC_CLIENT_SECRET_WEB=
JWT_TOKEN_EXPIRES_IN=8h
